      "  (func (export \"_start\")",
      "    (local $start i64) (local $end i64) (local $state i64) (local $checksum i64)",
      "    (local $remaining i32) (local $index i32) (local $state32 i32)",
      "    (local $address i32) (local $value i32) (local $offset i32)",
      "",
      "    ;; Serial xorshift recurrence plus the iteration counter prevents",
      "    ;; independent/vectorized iterations and a simple arithmetic-series fold.",
      "    (local.set $start (call $now))",
